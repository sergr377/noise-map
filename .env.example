# Скопируйте в .env и подставьте свои значения. .env в git не попадает.

# Ключ JavaScript API Яндекс Карт: https://yandex.ru/dev/maps/
# Получается в кабинете разработчика. Ограничьте его по HTTP-referrer —
# ключ виден в исходниках страницы любому посетителю.
VITE_YANDEX_API_KEY=your-key-here

# Ключ HTTP Геокодера — поиск по адресу. Это ОТДЕЛЬНЫЙ продукт и отдельный ключ:
# ключ JavaScript API геокодером не работает и наоборот.
#
# Имя без префикса VITE_ намеренно: такие переменные Vite не выдаёт в браузер.
# У геокодерного ключа нет ограничения по referer, поэтому попав в бандл он был
# бы доступен кому угодно. Фронтенд ходит через /api/geocode.
YANDEX_GEOCODER_KEY=your-geocoder-key-here

# HTTP-слой
PORT=8787

# Сколько расчётов крутить одновременно. Расчёт распространения и так забирает
# все ядра, поэтому больше единицы обычно только замедляет.
MAX_CONCURRENT_JOBS=1
