# Скопируйте в .env и подставьте свои значения. .env в git не попадает.

# Где лежит собранная подложка: .pmtiles, глифы и стиль. Собирается командой
# node scripts/build-tiles.mjs — подробности в README, раздел «Подложка».
# Пусто — каталог tiles/ рядом с проектом.
# TILES_DIR=tiles

# Геокодер — поиск по адресу. Пусто: публичный инстанс Nominatim.
# У него правило «не чаще запроса в секунду», которое сервер соблюдает сам;
# свой инстанс снимает и это ограничение.
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Как представляться геокодеру. Nominatim требует опознаваемый User-Agent с
# рабочим контактом и отдаёт 403 тем, кто представился чужим именем.
# NOMINATIM_CONTACT=noise-map (https://github.com/sergr377/noise-map)

# Прокси для исходящих запросов — нужен только там, откуда не открывается
# Overpass (проверка есть в README). Читают и сервер, и скрипты; переменная из
# оболочки перекрывает это значение. Схема только http:// или https://,
# socks5:// не поддерживается.
# HTTPS_PROXY=http://127.0.0.1:10809

# Инстансы Overpass — откуда берутся дороги, здания и землепользование. Через
# запятую или с новой строки. Пусто — встроенный список публичных зеркал
# (overpass-api.de, kumi.systems, maps.mail.ru, private.coffee).
#
# Зеркала общие для всего мира и под нагрузкой отвечают 504 или 429 вместо
# данных. Клиент обходит их по кругу, меняя ведущее зеркало от раунда к раунду,
# слушает Retry-After и разводит попытки джиттером — но это смягчение, а не
# лечение. Единственное настоящее лекарство от чужого сервера — свой:
# OVERPASS_ENDPOINTS=http://localhost:12345/api/interpreter

# Сколько всего времени отводится на получение данных OSM — на все зеркала и все
# раунды вместе, мс. Без потолка четыре зеркала по три раунда с попыткой в 240 с
# складываются почти в час ожидания на клик, весь расчёт которого занимает
# пятнадцать минут. Задача, не получившая данных за это время, падает с ошибкой,
# которая помечена как повторяемая: следующий клик по той же точке начнёт заново.
OVERPASS_BUDGET_MS=300000

# HTTP-слой
PORT=8787

# Сколько расчётов крутить одновременно. Расчёт распространения и так забирает
# все ядра, поэтому больше единицы обычно только замедляет.
MAX_CONCURRENT_JOBS=1

# Ограничение частоты по IP. Ноль в любой из переменных выключает свою корзину.
#
# Бюджет расчётов тратится только на запуск новой работы: кэш и подключение к
# уже идущей задаче не считаются. Холодный расчёт занимает все ядра на минуты,
# поэтому «6 в час с одного адреса» — это уже заметная доля машины.
JOB_LIMIT_BURST=2
JOB_LIMIT_PER_HOUR=6
# Геокодер тратит общую квоту ключа Яндекса, поэтому считается отдельно.
GEOCODE_LIMIT_RPM=20
# Всё остальное под /api.
RATE_LIMIT_RPM=60

# Сколько потоков прогресса (SSE) один адрес может держать открытыми разом.
# Это про занятость, а не про частоту: соединение живёт весь расчёт, а стоило
# одного токена корзины выше. Вкладка держит один поток и только пока ждёт
# результат, так что шесть — с запасом. Ноль выключает проверку.
STREAM_LIMIT_PER_IP=6

# Запросы с самой машины не ограничиваются: prewarm.mjs ходит через тот же API.
# Единица снимает исключение — так лимиты проверяются локально.
RATE_LIMIT_LOOPBACK=0

# Читать адрес клиента из X-Forwarded-For. Включайте ТОЛЬКО за обратным прокси:
# заголовок подделывается тривиально, и на открытом сервере это отключит лимит.
TRUST_PROXY=0

# Кто может обращаться к API из браузера, через запятую. Пусто — любой: для
# публичного сервиса без cookie и аутентификации это защитимый выбор, и он
# оставлен по умолчанию. Но холодный POST /api/noise занимает все ядра на
# минуты, поэтому в проде список стоит сузить до собственных доменов — иначе
# любой сторонний сайт может встроить вызов и потратить бюджет своего
# посетителя.
# ALLOWED_ORIGINS=https://noise.example.com,https://www.noise.example.com

# Дальность источников для предварительного прохода, метры; ноль его отключает.
# Предпросмотр показывает всю площадь примерно через минуту, тогда как точный
# расчёт заполняет её ячейками четверть часа. Чем меньше число, тем раньше карта
# и тем она грубее: на Тверской 75 м дают 38 с расчёта при занижении на 2.7 дБ,
# 150 м — 97 с при 1.1 дБ. Интерфейс называет эту погрешность прямо, так что
# менять число надо вместе с подписью в App.tsx. В кэш предпросмотр не попадает,
# а платит за него только тот, кто ждёт: прогрев кэша идёт без предпросмотра.
PREVIEW_SRC_DIST=75

# Как часто отдавать промежуточный кадр расчёта, мс; ноль выключает кадры.
# Это нижняя граница: пайплайн сам увеличивает паузу, если кадр вышел дорогим,
# чтобы кадры не съедали больше десятой части времени.
# По умолчанию выключены: кадр точен, но покрывает четверть круга, потому что
# распространение идёт ячейками, — а предпросмотр выше даёт всю площадь сразу.
PARTIAL_INTERVAL_MS=0

# Сколько ждать отменённый расчёт, прежде чем убить его принудительно.
KILL_GRACE_MS=5000
