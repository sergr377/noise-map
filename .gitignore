node_modules/
dist/
# Сборка фронтенда. В неё Vite вшивает ключ карт, поэтому в git ей не место.
dist-web/

# NoiseModelling distribution (148 MB) — unpacked by hand, see README
.tools/

# Per-run job directories: OSM extracts, H2 database files, output GeoJSON
jobs/

# Cached results served by the API
cache/

# Собранная подложка: .pmtiles на сотни мегабайт, глифы и копия стиля. Данные,
# а не исходник — собираются scripts/build-tiles.mjs. Сам стиль лежит в git,
# в basemap/style.json.
tiles/

# Secrets: API keys live here, never in git. .env.example holds the template.
.env
.env.*
!.env.example

# Логи длинных батчей прогрева
logs/

# Надстройка compose под конкретный хост: порт, TRUST_PROXY, CACHE_ONLY. Это
# свойство машины, а не проекта, и на каждом хосте она своя.
docker-compose.override.yml

# Аварийные дампы Git Bash под Windows
*.stackdump
