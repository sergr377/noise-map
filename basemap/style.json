{
  "version": 8,
  "name": "Noise map basemap",
  "metadata": {
    "noise-map:note": "Своя схема, а не позаимствованная целиком: подложка здесь фон под изофоны, которые ложатся сверху с прозрачностью 0.55. Отсюда три правила, которые нельзя нарушать при правках. Первое: всё ненасыщенное — цветной фон под полупрозрачной палитрой смещает читаемый уровень шума. Второе: дороги остаются белыми с серой обводкой и видны сквозь заливку — карта именно про них. Третье: здания рисуются с z14, потому что это те самые здания OSM, по которым считалось экранирование, и расхождение между картой и моделью тут недопустимо. Подписи только текстом, без иконок: спрайт не нужен, и его нет."
  },
  "glyphs": "/tiles/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "pmtiles:///tiles/basemap.pmtiles",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f6f4f0" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "grass", "farmland"]]],
      "paint": { "fill-color": "#eaeee3", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "paint": { "fill-color": "#e7ede0", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse-built",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["residential", "commercial", "industrial", "retail"]]
      ],
      "paint": { "fill-color": "#f1efea" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#cddfe9" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "minzoom": 9,
      "paint": {
        "line-color": "#cddfe9",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 16, 3]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e5e1d8",
        "fill-outline-color": "#d5cfc4",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0.4, 16, 0.9]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#dcd7cd",
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          6,
          1.2,
          12,
          ["match", ["get", "class"], ["motorway", "trunk"], 5, ["primary"], 4, 2.5],
          17,
          ["match", ["get", "class"], ["motorway", "trunk"], 22, ["primary"], 18, 12]
        ]
      }
    },
    {
      "id": "road-fill",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          6,
          0.4,
          12,
          ["match", ["get", "class"], ["motorway", "trunk"], 3.5, ["primary"], 2.8, 1.5],
          17,
          ["match", ["get", "class"], ["motorway", "trunk"], 18, ["primary"], 14, 9]
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#d3cdc2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 17, 2.5]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 6],
      "paint": {
        "line-color": "#c9c2b6",
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 12, 1.4]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 17, 13]
      },
      "paint": {
        "text-color": "#7a7266",
        "text-halo-color": "#f6f4f0",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#6f8ba0",
        "text-halo-color": "#f6f4f0",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["city", "town", "village", "suburb", "neighbourhood"]]
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          ["match", ["get", "class"], ["city"], 13, 10],
          14,
          ["match", ["get", "class"], ["city"], 20, ["town"], 16, 13]
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#5b5348",
        "text-halo-color": "#f6f4f0",
        "text-halo-width": 1.6
      }
    }
  ]
}
