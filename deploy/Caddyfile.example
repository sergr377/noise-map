# ОБРАЗЕЦ конфигурации Caddy для боевого сервера: /etc/caddy/Caddyfile.
#
# Домен заменить на свой. Проверить перед перезапуском:
#   caddy validate --config /etc/caddy/Caddyfile
#
# Демка noise-map. Caddy сам берёт и продлевает сертификат Let's Encrypt.
#
# Логи идут в journald (docker: journalctl -u caddy -f). Отдельный файл в
# /var/log/caddy требует ослабления песочницы юнита — не стоит того.
noisemap.online {
	# 127.0.0.1, а не localhost: где localhost резолвится сначала в ::1,
	# прокси уходит на IPv6 мимо порта Docker, и это выглядит как 502 при
	# живом контейнере. Проверено на машине разработки, стоило часа.
	reverse_proxy 127.0.0.1:8787 {
		# Понадобится при живом расчёте: поток прогресса (SSE) держится
		# открытым все 6–27 минут, буферизация его сломала бы.
		flush_interval -1
	}

	# Сервер сам жмёт GeoJSON; здесь это добирает статику фронтенда.
	# Уже сжатые ответы Caddy не трогает.
	encode zstd gzip
}
