# ОБРАЗЕЦ надстройки compose для боевого сервера.
#
# На сервере лежит как docker-compose.override.yml рядом с docker-compose.yml и
# в git не попадает (см. .gitignore): порт, режим и доверие заголовку — свойства
# конкретной площадки, а не проекта. Здесь — рабочая копия того, что стоит на
# демке, чтобы следующую площадку не собирать по памяти.
#
# Скопировать:  cp deploy/docker-compose.override.yml.example docker-compose.override.yml
#
# Проверить после запуска:
#   docker compose exec noise-map node /opt/smoke.mjs   (или с хоста по домену)
services:
  noise-map:
    environment:
      # Первая фаза: отдаём только прогретое, расчёт по клику не пускаем.
      # Когда дойдёт до живого расчёта — убрать эту строку и перезапустить.
      CACHE_ONLY: 1

      # Впереди Caddy, и он подключается с localhost. Без TRUST_PROXY адрес
      # брался бы из сокета, там всегда 127.0.0.1, а loopback освобождён от всех
      # лимитов — то есть лимитер выключился бы для каждого посетителя, и первым
      # пострадал бы /api/geocode: это чужая квота на нашем ключе.
      TRUST_PROXY: 1

    # Наружу порт не публикуем: снаружи ходят только через Caddy по 443.
    # Это же условие делает TRUST_PROXY безопасным — подделать X-Forwarded-For
    # в обход прокси некому. !override нужен потому, что Compose СЛИВАЕТ списки
    # портов, и базовый 8787:8787 остался бы вторым маппингом.
    ports: !override
      - "127.0.0.1:8787:8787"
